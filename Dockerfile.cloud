FROM python:3.12-slim-bookworm
ARG WILDLIFE_MODE=live
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 \
    WILDLIFE_MODE=${WILDLIFE_MODE} PORT=8080 TORCH_HOME=/tmp/torch
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
COPY requirements.txt speciesnet_requirements.txt ./
RUN python -m pip install --no-cache-dir numpy==2.3.5 Pillow==12.3.0 && \
    if [ "$WILDLIFE_MODE" = live ]; then \
      python -m pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.15.0 torchvision==0.29.2 && \
      python -m pip install --no-cache-dir -r requirements.txt -r speciesnet_requirements.txt; \
    fi
COPY . ./
RUN python -B build_demo.py --render-only && chmod -R a=rX /app
USER 65532:65532
EXPOSE 8080
CMD ["python", "-B", "cloud_app.py"]
